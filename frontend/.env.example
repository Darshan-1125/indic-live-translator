# LiveKit Server Configuration
# Replace with your actual LiveKit cloud or self-hosted server URL
VITE_LIVEKIT_URL=wss://your-livekit-server.livekit.cloud

# LiveKit Access Token (Provided by backend API in production)
VITE_LIVEKIT_TOKEN=

# Force Mock Mode (set to 'true' to always use mock UI without connecting to LiveKit)
VITE_USE_MOCK_MODE=false
